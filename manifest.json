{
  "manifest_version": 3,
  "name": "File Renamer",
  "version": "1.1.0",
  "description": "OCR-powered batch file renamer for PDFs, images, Word, Excel and more — matches names to a roster and applies configurable naming templates.",
  "permissions": ["tabs"],
  "host_permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
