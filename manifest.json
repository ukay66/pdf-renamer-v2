{
  "manifest_version": 3,
  "name": "Smart File Renamer",
  "short_name": "File Renamer",
  "version": "1.1.1",
  "description": "Batch rename any file type by matching filenames to a roster. Custom naming templates. Instant — no OCR or internet needed.",
  "permissions": ["tabs"],
  "host_permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
